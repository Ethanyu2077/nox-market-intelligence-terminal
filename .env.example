# Copy to .env: server/start.mjs, server/index.ts, auth-setup and history:policy load it automatically.
# Real shell/npm environment variables keep precedence over values in this file.
PORT=8787
# ---------------------------------------------------------------------------
# DeepSeek research analyst (server/ai/*, UI: Ask AI / DeepSeek Analyst).
# The assistant is read-only: it reads the deterministic evidence packet and never trades.
#
# Server key (preferred): set DEEPSEEK_API_KEY. It is only spendable by signed-in users.
# Browser key: leave the server key empty and let each operator paste their own key in
# Settings -> AI (or the assistant's gear icon). The key stays in that browser and is
# forwarded per request; set NOX_AI_ALLOW_CLIENT_KEY=false to forbid this entirely.
DEEPSEEK_API_KEY=
# Official base URL; a loopback gateway is the only plain-HTTP value accepted.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default model. Current catalogue: deepseek-flash, deepseek-v4-pro. Older keys may still
# use deepseek-chat / deepseek-reasoner; the picker also lists whatever the key can access.
DEEPSEEK_MODEL=deepseek-flash
NOX_AI_ALLOW_CLIENT_KEY=true
NOX_AI_MAX_OUTPUT_TOKENS=1600
NOX_AI_MAX_INPUT_CHARS=48000
NOX_AI_TIMEOUT_MS=90000
NOX_AI_RPM=20

# Legacy research-hypotheses route (kept for compatibility; the DeepSeek assistant above
# supersedes it). Opt-in, OpenAI-compatible endpoint, no request sent by default.
NOX_RESEARCH_AI_ENABLED=false
NOX_RESEARCH_AI_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
NOX_RESEARCH_AI_MODEL=local-model
NOX_RESEARCH_AI_KEY=
# ---------------------------------------------------------------------------
# Aster USDⓈ-M public REST (Binance-compatible). Override only for a mirror/gateway.
ASTER_REST_BASE=https://fapi.asterdex.com

# CCXT market-data layer (server-side only; the package is imported lazily).
# CCXT supplies extra USDT-perpetual venues and acts as a labelled fallback when a native
# REST adapter fails. It never replaces native WebSocket tapes or aggressor flow.
NOX_CCXT_ENABLED=true
# Comma-separated CCXT-only venues. Empty = no extra venues (native 9 remain unchanged).
# Supported: htx, bingx, phemex, bitfinex
NOX_CCXT_VENUES=
# Retry a failed native snapshot through CCXT (the row is marked partial + fallback).
NOX_CCXT_FALLBACK=true
# Use CCXT for spot markets that have no native snapshot adapter.
NOX_CCXT_SPOT=true
NOX_CCXT_TIMEOUT_MS=12000
# loadMarkets() catalogue TTL. HTX/BingX catalogues take 10-25s on a cold cache.
NOX_CCXT_MARKETS_TTL_MS=1800000

# Test-only outbound adapter. No HTTP publishing route or automatic dispatch is installed.
NOX_NEWSLIQUID_ENABLED=false
NEWSLIQUID_APP_ID=
NEWSLIQUID_APP_SECRET=
BINANCE_REST_BASE=https://fapi.binance.com
BINANCE_SPOT_REST_BASE=https://data-api.binance.vision
BINANCE_WS_BASE=wss://fstream.binance.com
# Binance Web3 developer credentials (NOT Binance exchange API keys).
# Server-side environment only; never use VITE_ names or commit real values.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=
DATA_DIR=.data
# Application-managed storage budgets in bytes. Invalid/zero values use the defaults.
NOX_JOURNAL_RETENTION_DAYS=45
NOX_JOURNAL_MAX_BYTES=2147483648
# Local fallback copies already committed to the verified database; included in the journal budget.
NOX_JOURNAL_ACK_CACHE_BYTES=268435456
# Replay reads one record at a time. Raise only for known larger legacy records.
NOX_HISTORY_MAX_RECORD_BYTES=16777216
# The bounded order-flow tape supports recent replay and CVD at either setting.
NOX_ARCHIVE_RAW_TRADES=false
# Event studies are computed on request. Enable continuous derived revision exports if needed.
NOX_OUTCOME_AUDIT_ENABLED=false
NOX_OUTCOME_RETENTION_DAYS=35
NOX_OUTCOME_MAX_BYTES=268435456
NOX_ORDERFLOW_MAX_BYTES=536870912
NOX_MARKET_CACHE_MAX_BYTES=134217728
NOX_TIMESCALE_RETENTION_DAYS=90
NOX_TIMESCALE_MAX_BYTES=4294967296
NOX_STORAGE_MIN_FREE_BYTES=536870912
# Optional database-native policy CLI (history:policy). Separate from the runtime budgets above.
NOX_HISTORY_COMPRESSION_DAYS=0
NOX_HISTORY_RETENTION_DAYS=0
NOX_DISK_WARNING_BYTES=5368709120
# Dedicated disposable TimescaleDB integration test database, never a production database.
NOX_TEST_DATABASE_URL=
# Optional. Without a configured database, history remains in the local durable journal.
DATABASE_URL=
NOX_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
# Set true behind HTTPS. Do not expose plain HTTP sessions over a public network.
NOX_SECURE_COOKIES=false
SCANNER_LIMIT=24

# CoinGlass V4 read-only market data (server-side only).
COINGLASS_API_KEY=

# Independent authentication SQLite directory; keep private and outside public hosting.
NOX_AUTH_DIR=var/auth
# Optional first-run setup code (24–256 characters); prefer npm run auth:setup-token.
NOX_BOOTSTRAP_TOKEN=
