# Copy to deploy/test/.env and replace the password. Never commit the real .env.
NOX_TEST_DB_NAME=nox_test
NOX_TEST_DB_USER=nox_test
NOX_TEST_DB_PASSWORD=change-me
# Consumed by scripts/acceptance/timescale.mjs
DATABASE_URL=postgres://nox_test:change-me@127.0.0.1:55432/nox_test
ACCEPTANCE_TEST_DB_NAME=nox_test
ACCEPTANCE_ALLOW_WRITES=1
# Admin session used only by the acceptance API
ACCEPTANCE_ADMIN_USER=acceptance-admin
ACCEPTANCE_ADMIN_PASSWORD=change-me-too
NOX_API_URL=http://127.0.0.1:8787
