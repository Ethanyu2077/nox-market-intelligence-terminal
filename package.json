{
  "name": "nox-market-intelligence-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "history:policy": "node --import tsx server/history-maintenance.ts",
    "dev": "concurrently -k -n api,web -c cyan,white \"node server/start.mjs\" \"vite --host 127.0.0.1\"",
    "dev:api": "node server/start.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/start.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "auth:setup-token": "node --import tsx server/auth-setup.ts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:evidence": "node scripts/e2e-evidence.mjs --base=http://127.0.0.1:4173"
  },
  "dependencies": {
    "ccxt": "^4.5.92",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-mosaic-component": "^7.2.1",
    "react-ts-tradingview-widgets": "^1.2.8",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "puppeteer-core": "^25.16.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
